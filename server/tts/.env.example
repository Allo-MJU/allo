# Server only. Copy to .env.local; never put this key in Android/Flutter/Unity.
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=ap-southeast-1
DASHSCOPE_WORKSPACE_ID=
FIREBASE_PROJECT_ID=
# Google Application Default Credentials (local service-account file or workload identity)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
TTS_VOICES_FILE=server/tts/voices.local.json
TTS_CACHE_DIR=/tmp/allo-tts-cache
