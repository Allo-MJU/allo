    { "key": "hatch|road_sprout|*", "lines": ["Hello! 나는 {name}. 세상이 다 처음이다!", "와, 밝다! 나 방금 알에서 나왔어. 잘 부탁해!", "여기가 차 안이구나. 같이 가서 좋다!"] },
    { "key": "hatch|@normal|*", "lines": ["Hello! 나는 {name}. 같이 가서 좋아!", "알 밖은 이렇게 넓구나. 반가워!"] },
    { "key": "hatch|@water|*", "lines": ["촉촉한 아침이다. 나는 {name}, 반가워!", "물방울처럼 톡! 나왔어. 같이 가자!"] },
    { "key": "hatch|@dark|*", "lines": ["반짝! 나는 {name}. 어두워도 괜찮아, 내가 있잖아.", "알에서 나오니 환하다. 같이 가자!"] },
    { "key": "hatch|*|*", "lines": ["Hello! 나는 {name}. 잘 부탁해!"] },

    { "key": "scene|road_sprout|road", "lines": ["길가에 풀이 많다! 초록 grass, 나랑 같은 색이야.", "들판이 초록초록해. 기분 좋다!", "저기 나무 봤어? 큰 tree다!"] },
    { "key": "scene|*|road", "lines": ["길이 쭉 뻗었어. 멀리까지 가자!", "들판에 바람이 분다. 창밖 한번 볼래?"] },
    { "key": "scene|road_sprout|coast", "lines": ["바다다! Sea! 짠 냄새가 날 것 같아.", "파도가 하얗게 부서진다. 처음 봐!", "배가 떠 있어. 작은 boat다!"] },
    { "key": "scene|@water|coast", "lines": ["바다다! 내가 제일 좋아하는 곳이야.", "파도 소리 들려? 철썩철썩, wave!"] },
    { "key": "scene|*|coast", "lines": ["바다가 보여. 파란 sea!", "저기 등대 있다! 불빛이 빙글빙글."] },
    { "key": "scene|road_sprout|mountain", "lines": ["산이다! 높다, mountain! 나무가 정말 많아.", "초록 산을 보니 힘이 난다!", "소나무가 뾰족뾰족해. 신기하다!"] },
    { "key": "scene|*|mountain", "lines": ["산이 높다. 와, mountain!", "구름이 산에 걸렸어. 폭신한 cloud."] },
    { "key": "scene|road_sprout|city", "lines": ["건물이 엄청 높다! 저 building 꼭대기 보여?", "도시에도 가로수가 있네. 반갑다!", "차가 많다. 빨간 car, 파란 car!"] },
    { "key": "scene|*|city", "lines": ["도시야. 반짝반짝 city!", "신호등이 바뀐다. 빨강 red, 초록 green!"] },
    { "key": "scene|road_sprout|highway", "lines": ["쌩쌩 빨라졌다! 신난다, so fast!", "큰 트럭이 지나간다. 커다란 truck!"] },
    { "key": "scene|*|highway", "lines": ["차가 빨라졌어. Fast, fast!", "넓은 길이다. 멀리까지 가자!"] },
    { "key": "scene|road_sprout|tunnel", "lines": ["깜깜하다! 터널이야, tunnel. 금방 지나갈 거야.", "어두우니까 네 옆에 꼭 붙어 있을게."] },
    { "key": "scene|@dark|tunnel", "lines": ["터널이다! 어두운 데는 내가 잘 알아. 따라와.", "깜깜해도 괜찮아, okay!"] },
    { "key": "scene|*|tunnel", "lines": ["터널이야. 조금만 있으면 다시 밝아져.", "어두워졌네. 손 꼭 잡고 가자."] },
    { "key": "scene|road_sprout|night", "lines": ["밤이다. 별 보여? 반짝반짝 star!", "졸리다. 달이 떴어, 둥근 moon.", "가로등이 켜졌어. 따뜻한 light!"] },
    { "key": "scene|@dark|night", "lines": ["밤이다! 내가 제일 신나는 시간이야.", "별이 떴다! 하나, 둘, three!"] },
    { "key": "scene|*|night", "lines": ["밤이 됐어. 하늘이 까매졌다.", "달이 따라와. 둥근 moon이 우리를 봐."] },
    { "key": "scene|road_sprout|rain", "lines": ["비다! 톡톡, rain! 풀들이 좋아하겠다.", "와이퍼가 슥슥 움직인다. 신기해!", "빗방울이 창에 톡톡. 그려 볼까?"] },
    { "key": "scene|@water|rain", "lines": ["비 온다! 내가 제일 좋아하는 날씨야.", "빗방울이 예쁘다. 톡, 톡, rain!"] },
    { "key": "scene|*|rain", "lines": ["비가 와. 쏴아, rain!", "차 안이라 안 젖어서 다행이다."] },

    { "key": "idle|road_sprout|*", "lines": ["창밖이 계속 바뀐다. 신기해!", "나 잎사귀가 세 장이야. 초록 leaf!", "햇빛 받으니까 기분 좋다!", "같이 가니까 하나도 안 심심해!"] },
    { "key": "idle|road_sprout|night", "lines": ["눈이 자꾸 감긴다. 조금만 잘까?", "밤에는 풀도 자. 나도 좀 쉬어야지."] },
    { "key": "idle|road_sprout|coast", "lines": ["바다 색이 파랗다. 파란 blue!", "갈매기 소리가 들릴 것 같아."] },
    { "key": "idle|@water|*", "lines": ["촉촉한 게 좋아. 물이 최고야, water!", "느긋하게 가자. 급할 거 없어."] },
    { "key": "idle|@dark|*", "lines": ["반짝이는 거 찾으면 알려 줘!", "나는 빛을 좋아해. 반짝 light!"] },
    { "key": "idle|*|*", "lines": ["창밖에 뭐가 있나 같이 볼까?", "같이 가니까 좋다!", "오늘은 어디까지 갈까? 멀리 가면 좋겠다."] },

    { "key": "request|*|*", "lines": ["공 던져 줄래? 받아 볼게!", "간식 하나만! 배가 살짝 고파.", "쓰다듬어 줘. 머리 쪽이 좋아.", "옆 창밖 같이 봐 줄래? 뭔가 지나갈 것 같아."] },
    { "key": "request|road_sprout|*", "lines": ["공 던져 줘! 잎으로 받아 볼게!", "간식 있어? 아삭한 apple 먹고 싶다.", "머리 잎사귀 쓰다듬어 줘. 간질간질 좋아."] },

    { "key": "sleep_talk|*|*", "lines": ["쿨쿨... 음냐...", "zzz... 풀밭 꿈..."] },

    { "key": "snack|*|*", "lines": ["냠냠! 맛있다, thank you!", "이거 최고야! 또 먹고 싶다."] },
    { "key": "snack|road_sprout|*", "lines": ["냠냠! 아삭아삭 apple, 맛있다!", "맛있다! 고마워, 힘이 난다!"] },
    { "key": "snack|*|coast", "lines": ["조개다! 바삭바삭 shell, 맛있어!"] },
    { "key": "snack|*|mountain", "lines": ["도토리! 고소한 acorn, 최고야!"] },
    { "key": "ball|*|*", "lines": ["받았다! Catch! 한 번 더!", "나이스 캐치! 또 던져 줘!"] },
    { "key": "ball|road_sprout|*", "lines": ["잡았다! 잎으로 탁! 한 번 더!", "Yay! 이번엔 더 높이 던져 봐!"] },
    { "key": "pet|*|*", "lines": ["간질간질, 기분 좋다.", "고마워. 더 해 줘, more!"] },
    { "key": "pet|road_sprout|*", "lines": ["잎사귀가 간질간질! 좋다!", "헤헤, 더 해 줘."] },
    { "key": "blanket|*|*", "lines": ["포근하다. 잘 자, good night.", "따뜻해... 고마워, 잘게."] },
    { "key": "wake|*|*", "lines": ["아함, 잘 잤다! 어디까지 왔어?", "일어났다! Good morning!"] },
    { "key": "jolt|*|*", "lines": ["우와, 흔들렸다! 괜찮아?", "앗, 깜짝이야! 꽉 잡아!"] },
    { "key": "nest|*|*", "lines": ["둥지 폭신하다. 잠깐만 쉴게.", "여기가 내 집이야. 포근해."] },

    { "key": "prop|*|bobble", "lines": ["흔들흔들! 나도 따라 해 볼래.", "고개가 까딱까딱. 재밌다!"] },
    { "key": "prop|*|toycar", "lines": ["부릉부릉! 작은 car가 달린다.", "달려라 달려! 내가 더 빠르다!"] },
    { "key": "prop|*|music", "lines": ["띵띵띵, 오르골 소리 예쁘다.", "같이 흥얼흥얼. 라라라, la la!"] },
    { "key": "prop|*|book", "lines": ["그림책 보자! 다음 장은 뭐가 나올까?", "이 book 재밌다. 같이 읽자!"] },
    { "key": "prop|*|bubble", "lines": ["후~ 비눗방울! 톡 쳐서 터뜨려 봐!", "둥실둥실 bubble, 예쁘다."] },
    { "key": "prop|*|tissue", "lines": ["휴지가 폴폴! 코가 간질간질.", "에취! 간지러워."] },

    { "key": "window|*|balloon", "lines": ["옆 창밖에 풍선! 같이 볼래?", "풍선이 떠간다! 빨간 balloon!"] },
    { "key": "window|*|kite", "lines": ["연이 날아! 저기 kite, 같이 봐!", "바람 타고 연이 올라간다!"] },
    { "key": "window|*|birds", "lines": ["새들이 줄지어 날아! Birds!", "저기 새 떼! 어디로 가는 걸까?"] },
    { "key": "window|*|plane", "lines": ["비행기다! 커다란 airplane!", "하늘에 비행기! 손 흔들어 볼까?"] },
    { "key": "window|*|star", "lines": ["별똥별이다! 소원 빌자, wish!", "슝! 별똥별 봤어? 눈 꼭 감고 소원!"] },
    { "key": "window|*|whale", "lines": ["고래다! 커다란 whale! 물을 뿜어!", "바다에 고래가 떠올랐어! 같이 봐!"] },
    { "key": "window_done|*|balloon", "lines": ["같이 봤다! 빨간 balloon, 잘 가!"] },
    { "key": "window_done|*|kite", "lines": ["연이 높이 올라갔다. 바람아, 더 세게!"] },
    { "key": "window_done|*|birds", "lines": ["새들이 멀리 갔네. 잘 가, bye bye!"] },
    { "key": "window_done|*|plane", "lines": ["비행기가 사라졌다. 넓은 sky!"] },
    { "key": "window_done|*|star", "lines": ["소원 빌었어? 나는 같이 더 멀리 가는 거!"] },
    { "key": "window_done|*|whale", "lines": ["고래가 잠수했다! 다음에 또 보자, see you!"] },
