{
  "_doc": "차 안(Unity) 말풍선 대사. 키 = 상황|대상|문맥. 대상: 종 id → @속성 → *. 문맥: 장면(road coast mountain city highway tunnel night rain) 또는 이벤트 이름 또는 *. 규칙은 docs/dialogue-style.md (반말, 50자 이내 3문장, 영어 단어는 한 문장에 1개 + 한글 뜻, 아이에게 되묻기 금지). {name} = 종 한글 이름, {name:이/가} {name:은/는} {name:아/야} 조사.",
  "items": [
    { "key": "name|road_sprout|*", "lines": ["길싹이"] },
    { "key": "name|bridge_hopper|*", "lines": ["다리뛰기"] },
    { "key": "name|mountain_sprite|*", "lines": ["산정령"] },
    { "key": "name|puddle_pip|*", "lines": ["웅덩이삐약"] },
    { "key": "name|river_glider|*", "lines": ["강미끄럼"] },
    { "key": "name|tide_keeper|*", "lines": ["물결지기"] },
    { "key": "name|storm_lantern|*", "lines": ["폭풍등"] },
    { "key": "name|sea_mist|*", "lines": ["바다안개"] },
    { "key": "name|lamp_moth|*", "lines": ["등불나방"] },
    { "key": "name|tunnel_moth|*", "lines": ["터널나방"] },
    { "key": "name|star_owl|*", "lines": ["별부엉이"] },
    { "key": "name|highway_comet|*", "lines": ["고속혜성"] },

    { "key": "hatch|road_sprout|*", "lines": ["안녕! 나는 {name}. 세상이 다 처음이다!", "와, 밝다! 나 방금 알에서 나왔어. 잘 부탁해!", "여기가 차 안이구나. 같이 가서 좋다!"] },
    { "key": "hatch|@normal|*", "lines": ["안녕, 나는 {name}. 같이 가서 좋아!", "알 밖은 이렇게 넓구나. 반가워!"] },
    { "key": "hatch|@water|*", "lines": ["촉촉한 아침이다. 나는 {name}, 반가워!", "물방울처럼 톡! 나왔어. 같이 가자!"] },
    { "key": "hatch|@dark|*", "lines": ["반짝! 나는 {name}. 어두워도 괜찮아, 내가 있잖아.", "알에서 나오니 환하다. 같이 가자!"] },
    { "key": "hatch|*|*", "lines": ["안녕, 나는 {name}. 잘 부탁해!"] },

    { "key": "scene|road_sprout|road", "lines": ["길가에 풀이 많다! 풀은 영어로 grass야.", "들판이 초록초록해. 나랑 같은 색이다!", "저기 나무 봤어? 나무는 tree야."] },
    { "key": "scene|*|road", "lines": ["길이 쭉 뻗었어. 길은 영어로 road야.", "들판에 바람이 분다. 창밖 한번 볼래?"] },
    { "key": "scene|road_sprout|coast", "lines": ["바다다! 바다는 영어로 sea. 짠 냄새가 날 것 같아.", "파도가 하얗게 부서진다. 처음 봐!", "배가 떠 있어. 배는 boat야."] },
    { "key": "scene|@water|coast", "lines": ["바다다! 내가 제일 좋아하는 곳이야.", "파도 소리 들려? 파도는 영어로 wave야."] },
    { "key": "scene|*|coast", "lines": ["바다가 보여. 바다는 영어로 sea야.", "저기 등대 있다! 등대는 lighthouse야."] },
    { "key": "scene|road_sprout|mountain", "lines": ["산이다! 산은 영어로 mountain. 나무가 정말 많다!", "초록 산을 보니 힘이 난다!", "소나무가 뾰족뾰족해. 신기하다!"] },
    { "key": "scene|*|mountain", "lines": ["산이 높다. 산은 영어로 mountain이야.", "구름이 산에 걸렸어. 구름은 cloud야."] },
    { "key": "scene|road_sprout|city", "lines": ["건물이 엄청 높다! 건물은 영어로 building이야.", "도시에도 가로수가 있네. 반갑다!", "차가 많다. 차는 영어로 car야."] },
    { "key": "scene|*|city", "lines": ["도시야. 도시는 영어로 city.", "신호등이 반짝여. 빨강은 red. 초록은 green!"] },
    { "key": "scene|road_sprout|highway", "lines": ["쌩쌩 빨라졌다! 고속도로는 highway야.", "큰 트럭이 지나간다. 트럭은 truck!"] },
    { "key": "scene|*|highway", "lines": ["차가 빨라졌어. 빠른 건 영어로 fast야.", "고속도로는 highway. 멀리까지 가자!"] },
    { "key": "scene|road_sprout|tunnel", "lines": ["깜깜하다! 터널은 영어로 tunnel이야. 금방 지나갈 거야.", "어두우니까 네 옆에 꼭 붙어 있을게."] },
    { "key": "scene|@dark|tunnel", "lines": ["터널이다! 어두운 데는 내가 잘 알아. 따라와.", "깜깜해도 괜찮아. 터널은 tunnel이야."] },
    { "key": "scene|*|tunnel", "lines": ["터널이야. 터널은 영어로 tunnel. 곧 밝아져.", "어두워졌네. 조금만 기다려 보자."] },
    { "key": "scene|road_sprout|night", "lines": ["밤이다. 밤은 영어로 night. 별 보여?", "졸리다. 달은 영어로 moon이야.", "가로등이 켜졌어. 빛은 light!"] },
    { "key": "scene|@dark|night", "lines": ["밤이다! 내가 제일 신나는 시간이야.", "별은 영어로 star. 하나, 둘, 셋!"] },
    { "key": "scene|*|night", "lines": ["밤이 됐어. 밤은 영어로 night야.", "달이 따라와. 달은 moon이야."] },
    { "key": "scene|road_sprout|rain", "lines": ["비다! 비는 영어로 rain. 풀들이 좋아하겠다.", "와이퍼가 슥슥 움직인다. 신기해!", "빗방울이 창에 톡톡. 그려 볼까?"] },
    { "key": "scene|@water|rain", "lines": ["비 온다! 내가 제일 좋아하는 날씨야.", "빗방울은 영어로 raindrop이야. 예쁘다."] },
    { "key": "scene|*|rain", "lines": ["비가 와. 비는 영어로 rain이야.", "우산은 umbrella! 차 안이라 안 젖어서 다행이다."] },

    { "key": "idle|road_sprout|*", "lines": ["창밖이 계속 바뀐다. 신기해!", "나 잎사귀가 세 장이야. 잎은 영어로 leaf!", "햇빛 받으니까 기분 좋다!", "같이 가니까 하나도 안 심심해!"] },
    { "key": "idle|road_sprout|night", "lines": ["눈이 자꾸 감긴다. 조금만 잘까?", "밤에는 풀도 자. 나도 좀 쉬어야지."] },
    { "key": "idle|road_sprout|coast", "lines": ["바다 색이 파랗다. 파랑은 영어로 blue!", "갈매기 소리가 들릴 것 같아."] },
    { "key": "idle|@water|*", "lines": ["촉촉한 게 좋아. 물은 영어로 water야.", "느긋하게 가자. 급할 거 없어."] },
    { "key": "idle|@dark|*", "lines": ["반짝이는 거 찾으면 알려 줘!", "빛은 영어로 light. 나는 빛을 좋아해."] },
    { "key": "idle|*|*", "lines": ["창밖에 뭐가 있나 같이 볼까?", "같이 가니까 좋다!", "오늘은 어디까지 갈까? 멀리 가면 좋겠다."] },

    { "key": "request|*|*", "lines": ["공 던져 줄래? 받아 볼게!", "간식 하나만! 배가 살짝 고파.", "쓰다듬어 줘. 머리 쪽이 좋아.", "옆 창밖 같이 봐 줄래? 뭔가 지나갈 것 같아."] },
    { "key": "request|road_sprout|*", "lines": ["공 던져 줘! 잎으로 받아 볼게!", "간식 있어? 사과는 영어로 apple!", "머리 잎사귀 쓰다듬어 줘. 간질간질 좋아."] },

    { "key": "sleep_talk|*|*", "lines": ["쿨쿨... 음냐...", "zzz... 풀밭 꿈..."] },

    { "key": "snack|*|*", "lines": ["냠냠! 맛있다, 고마워!", "간식은 영어로 snack. 이거 최고야!"] },
    { "key": "snack|road_sprout|*", "lines": ["냠냠! 사과는 apple. 아삭하다!", "맛있다! 고마워, 힘이 난다!"] },
    { "key": "snack|*|coast", "lines": ["조개다! 조개는 영어로 shell. 바삭바삭!"] },
    { "key": "snack|*|mountain", "lines": ["도토리! 도토리는 acorn. 고소하다!"] },
    { "key": "ball|*|*", "lines": ["받았다! 공은 영어로 ball. 한 번 더!", "나이스 캐치! 또 던져 줘!"] },
    { "key": "ball|road_sprout|*", "lines": ["잡았다! 잎으로 탁! 한 번 더!", "공은 ball! 이번엔 더 높이 던져 봐!"] },
    { "key": "pet|*|*", "lines": ["간질간질, 기분 좋다.", "고마워. 쓰다듬는 건 영어로 pet이야."] },
    { "key": "pet|road_sprout|*", "lines": ["잎사귀가 간질간질! 좋다!", "헤헤, 더 해 줘."] },
    { "key": "blanket|*|*", "lines": ["포근하다. 담요는 영어로 blanket. 잘 자.", "따뜻해... 고마워, 잘게."] },
    { "key": "wake|*|*", "lines": ["아함, 잘 잤다! 어디까지 왔어?", "일어났다! 다시 같이 보자."] },
    { "key": "jolt|*|*", "lines": ["우와, 흔들렸다! 괜찮아?", "앗, 깜짝이야! 꽉 잡아!"] },
    { "key": "nest|*|*", "lines": ["둥지 폭신하다. 잠깐만 쉴게.", "여기가 내 집이야. 포근해."] },

    { "key": "prop|*|bobble", "lines": ["흔들흔들! 나도 따라 해 볼래.", "고개가 까딱까딱. 재밌다!"] },
    { "key": "prop|*|toycar", "lines": ["부릉부릉! 장난감 차도 영어로 car야.", "달려라 달려! 내가 더 빠르다!"] },
    { "key": "prop|*|music", "lines": ["띵띵띵, 오르골 소리 예쁘다.", "노래는 영어로 song. 같이 흥얼흥얼."] },
    { "key": "prop|*|book", "lines": ["그림책 보자! 책은 영어로 book이야.", "다음 장은 뭐가 나올까?"] },
    { "key": "prop|*|bubble", "lines": ["후~ 비눗방울! 톡 쳐서 터뜨려 봐!", "둥실둥실. 비눗방울은 bubble이야."] },
    { "key": "prop|*|tissue", "lines": ["휴지가 폴폴! 코는 영어로 nose!", "에취! 간지러워."] },

    { "key": "window|*|balloon", "lines": ["옆 창밖에 풍선! 같이 볼래?", "풍선이 떠간다! 풍선은 영어로 balloon이야."] },
    { "key": "window|*|kite", "lines": ["연이 날아! 연은 영어로 kite. 같이 봐!", "바람 타고 연이 올라간다!"] },
    { "key": "window|*|birds", "lines": ["새들이 줄지어 날아! 새는 영어로 bird야.", "저기 새 떼! 어디로 가는 걸까?"] },
    { "key": "window|*|plane", "lines": ["비행기다! 비행기는 영어로 airplane.", "하늘에 비행기! 손 흔들어 볼까?"] },
    { "key": "window|*|star", "lines": ["별똥별이다! 별은 영어로 star. 소원 빌자!", "슝! 별똥별 봤어? 눈 꼭 감고 소원!"] },
    { "key": "window|*|whale", "lines": ["고래다! 고래는 영어로 whale. 물을 뿜어!", "바다에 고래가 떠올랐어! 같이 봐!"] },
    { "key": "window_done|*|balloon", "lines": ["같이 봤다! 풍선, balloon! 또 뭐가 올까?"] },
    { "key": "window_done|*|kite", "lines": ["연이 높이 올라갔다. 바람은 영어로 wind!"] },
    { "key": "window_done|*|birds", "lines": ["새들이 멀리 갔네. 잘 가! 영어로 bye!"] },
    { "key": "window_done|*|plane", "lines": ["비행기가 사라졌다. 하늘은 영어로 sky!"] },
    { "key": "window_done|*|star", "lines": ["소원 빌었어? 나는 같이 더 멀리 가는 거!"] },
    { "key": "window_done|*|whale", "lines": ["고래가 잠수했다! 물은 영어로 water야."] },
    { "key": "window_done|*|*", "lines": ["같이 봤다! 또 뭐가 지나가나 보자."] }
  ]
}
