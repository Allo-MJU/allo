<?xml version="1.0" encoding="utf-8"?>
<!-- 디버그 빌드에만 합쳐진다. TTS 확인용 브로드캐스트 (DebugSpeakReceiver). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver android:name=".debug.DebugSpeakReceiver" android:exported="true">
            <intent-filter>
                <action android:name="ai.allo.car.debug.SPEAK" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
