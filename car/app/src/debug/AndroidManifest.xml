<?xml version="1.0" encoding="utf-8"?>
<!-- 디버그 빌드에만 합쳐진다. 에뮬레이터 확인용 브로드캐스트 (TTS 발화, 내비 목적지). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver android:name=".debug.DebugSpeakReceiver" android:exported="true">
            <intent-filter>
                <action android:name="ai.allo.car.debug.SPEAK" />
            </intent-filter>
        </receiver>
        <receiver android:name=".debug.DebugRouteReceiver" android:exported="true">
            <intent-filter>
                <action android:name="ai.allo.car.debug.ROUTE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
