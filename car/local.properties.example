# 복사해서 local.properties 로 저장 (git 제외)
# sdk.dir=/Users/<you>/Library/Android/sdk
ALLO_DB_URL=https://<project>-default-rtdb.asia-southeast1.firebasedatabase.app

# Same development Firebase project as phone. Enable anonymous Auth; deploy callable session functions.
FIREBASE_API_KEY=<firebase-client-api-key>
FIREBASE_PROJECT_ID=<project-id>
FIREBASE_FUNCTIONS_REGION=asia-northeast3
