{
  "rules": {
    "sessions": {
      "$sid": {
        ".read": "data.exists() && now - data.child('meta/createdAt').val() < 86400000",
        ".write": "!data.exists() || now - data.child('meta/createdAt').val() < 86400000",
        "meta": {
          ".validate": "newData.hasChildren(['createdAt', 'pairCode', 'paired', 'carAppVersion'])"
        },
        "vehicle": {
          ".validate": "newData.hasChildren(['ts', 'gear'])",
          "lat": { ".validate": false },
          "lng": { ".validate": false },
          "latitude": { ".validate": false },
          "longitude": { ".validate": false }
        },
        "game": {
          ".validate": "newData.hasChildren(['ts', 'stage'])"
        },
        "events": {
          "$pushId": {
            ".validate": "newData.hasChildren(['ts', 'type', 'by'])"
          }
        }
      }
    }
  }
}
